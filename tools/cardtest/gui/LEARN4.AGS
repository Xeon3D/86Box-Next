# LEARN4.AGS -- developer aid, round 4: end screens of Final Reality and
# 3DMark2000, and the DCT 1.30 WHQL display kit's installer and manager.
autodismiss 1
on "License Agreement" Accept
closeclass CabinetWClass
log Final Reality full run
run "%PF%\Final Reality\FR.exe" "%PF%\Final Reality"
wait "Final Reality Benchmark" 90
click "Run benchmark"
pause 120
wait "Final Reality" 3000
sleep 10
dump
shotscreen fr_end
read frend
kill
sleep 3
log 3DMark2000 default benchmark
run "%PF%\MadOnion.com\3DMark2000\3DMark2000.exe" "%PF%\MadOnion.com\3DMark2000"
wait class:#32770 120
click "Run Default Benchmark"
pause 120
wait "Result" 5400
sleep 10
dump
shotscreen m2000_end
read m2000end
kill
sleep 3
log DCT 1.30 install
run "%CD2%\DCT130\Setup.exe" "%CD2%\DCT130"
wizard 1800
shotscreen dct_after
dump
