# DX7SDK.AGS -- the DirectX 7.0a SDK's prebuilt samples from disc 2: each one
# is started (working folder = its media folder), screenshotted after a few
# seconds and closed (Esc, then killed). A sample that complains about the
# device shows up as a dismissed dialog in the log. No install needed.
autodismiss 1
closeclass CabinetWClass
log d3dim/bend
run "%CD2%\DX7SDK\samples\multimedia\d3dim\bin\bend.exe" "%CD2%\DX7SDK\samples\multimedia\d3dim\media"
waitmine 60
sleep 12
shot d3dim_bend
keys {ESC}
sleep 3
kill
sleep 2
log d3dim/billboard
run "%CD2%\DX7SDK\samples\multimedia\d3dim\bin\billboard.exe" "%CD2%\DX7SDK\samples\multimedia\d3dim\media"
