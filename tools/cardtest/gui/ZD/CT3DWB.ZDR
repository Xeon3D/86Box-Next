; CARDTEST: 3D WinBench 2000 (3D WinMark + quality/feature/filter tests) at
; 640x480x32 + 24-bit Z (TNT-class cards have no 24-bit Z at 16 bpp, which
; some of the tests ask for), no reboot, no halt on errors; results to C:\CTRES\GUI\ZDWB.
[Config]
Benchmark=3DWB2000
[Environment]
[Options]
ExitBenchmark=True
DemoMode=False
SystemConfigurationCheck=False
[Messages]
InitMessage=3,CARDTEST: 3D WinBench 2000 is starting.
[Step1]
SuiteSection=Suite1
ClearResults=True
Database=c:\ZDBench\Results\CT3DWB.ztd
TextFile=c:\ctres\gui\zdwb\3dwb2000.txt
CSVFile=c:\ctres\gui\zdwb\3dwb2000.csv
3D WinBench 2000 Scene Tests:DirectDraw Hardware=0
3D WinBench 2000 Scene Tests:Direct3D Primary=3
3D WinBench 2000 Scene Tests:Use TnL HAL=No
3D WinBench 2000 Scene Tests:QualityInteraction=0
3D WinBench 2000 Scene Tests:Render Buffers=0
3D WinBench 2000 Scene Tests:Render Mode=0
3D WinBench 2000 Scene Tests:Quality Mode=0
3D WinBench 2000 Scene Tests:Audible Timing=0
3D WinBench 2000 Scene Tests:Screen Width=640
3D WinBench 2000 Scene Tests:Screen Height=480
3D WinBench 2000 Scene Tests:Color Depth=32
3D WinBench 2000 Scene Tests:Z Depth=24
3D WinBench 2000 Scene Tests:FullScreen=Yes
3D WinBench 2000 Scene Tests:VSync=No
3D WinBench 2000 Scene Tests:Stereo=No
3D WinBench 2000 Scene Tests:Antialiasing=No
3D WinBench 2000 Scene Tests:UseWBuffer=No
3D WinBench 2000 Scene Tests:CheckRefreshRate=No
3D WinBench 2000 Scene Tests:RefreshRate=75
3D WinBench 2000 Scene Tests:Texture Mapping=Yes
3D WinBench 2000 Scene Tests:Mag Texture Filter=1
3D WinBench 2000 Scene Tests:Min Texture Filter=1
3D WinBench 2000 Scene Tests:Mip Texture Filter=1
3D WinBench 2000 Scene Tests:Perspective Correction=Yes
3D WinBench 2000 Scene Tests:Texture Transparency=0
3D WinBench 2000 Scene Tests:Manual=0
3D WinBench 2000 Scene Tests:Shade Mode=1
3D WinBench 2000 Scene Tests:Dithering=Yes
3D WinBench 2000 Scene Tests:Fill Mode=2
3D WinBench 2000 Scene Tests:Lighting=1
3D WinBench 2000 Scene Tests:Specular Highlights=No
3D WinBench 2000 Scene Tests:Ambient=Yes
3D WinBench 2000 Scene Tests:Fog=0
3D WinBench 2000 Scene Tests:Scene Name=RaceTrackB2G1T1.sdl
3D WinBench 2000 Scene Tests:Frames=0
3D WinBench 2000 Scene Tests:StartFrame=1
3D WinBench 2000 Scene Tests:CameraPath=3
Common Properties:Halt On Errors=No
